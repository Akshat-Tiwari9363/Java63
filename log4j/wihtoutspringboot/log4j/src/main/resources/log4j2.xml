<Configuration status="INFO">
    <Appenders>
        <Console name="LoggingToConsole" target="SYSTEM_OUT">
            <PatternLayout>
                <Pattern>
                    %d - %c - [%M] - (%p) - %m - %n
                </Pattern>
            </PatternLayout>
        </Console>
        <File name="LoggingToFile" fileName="logs/log4j.log">
            <PatternLayout>
                <Pattern>
                    %d - %c - [%M] - (%p) - %m - %n
                </Pattern>
            </PatternLayout></File>
    </Appenders>
    <Loggers>
        <Root level="debug">
            <AppenderRef ref="LoggingToConsole"/>
            <AppenderRef ref="LoggingToFile"/>
        </Root></Loggers>
</Configuration>